# Copy to .env.prod on your Ubuntu server and fill in real values:
#   cp .env.prod.example .env.prod

# Supabase PostgreSQL Session Pooler URI (IPv4-safe):
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.yourref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Optional: only needed if calling backend directly from another origin (e.g. Vercel frontend)
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Ports exposed on the Ubuntu server
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Keep "same-origin" when running both frontend + backend on Ubuntu (zero CORS setup!)
NEXT_PUBLIC_API_URL=same-origin
